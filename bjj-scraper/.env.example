# --- Gemini (překlad a strukturování článků) ---
# API klíč z Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# free-tier model with available quota for the local demo; remove once billing is enabled to use gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Scraper ---
# Cron rozvrh pro daemon (npm start). Výchozí: každý den v 6:00.
SCRAPE_SCHEDULE=0 6 * * *

# Headless prohlížeč (true/false)
HEADLESS=true

# Výstupní adresář interní storage "Popelína"
POPELINA_DIR=./popelina

# Zpracovat jen články z posledních N dní (0 = bez omezení)
DAYS_BACK=1

# Max počet kandidátů navštívených na jeden zdroj (listing je newest-first)
MAX_CANDIDATES=10

# Prodleva mezi requesty na články v ms
SCRAPE_DELAY_MS=500
